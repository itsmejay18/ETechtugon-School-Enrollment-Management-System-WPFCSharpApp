<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <appSettings>
        <!-- Bootstrap connection values (used before DB-driven profile values are loaded). -->
        <add key="DbHost" value="localhost" />
        <add key="DbPort" value="3306" />
        <add key="DbName" value="schoolmanagementsystem" />
        <add key="DbUser" value="root" />
        <add key="DbPassword" value="root" />
        <add key="DbMode" value="Local" />
    </appSettings>
    <connectionStrings>
        <!-- MySQL (Workbench / local server) -->
        <add name="SchoolDb"
             connectionString="Server=localhost;Port=3306;Database=schoolmanagementsystem;Uid=root;Pwd=root;SslMode=Disabled;AllowPublicKeyRetrieval=True;"
             providerName="MySql.Data.MySqlClient" />
    </connectionStrings>
</configuration>
