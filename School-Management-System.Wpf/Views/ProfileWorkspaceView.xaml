<UserControl x:Class="School_Management_System.Wpf.Views.ProfileWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Profile"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,8,0,0"
                           Text="Signed-in account details for this workspace session."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Width="96"
                            Height="96"
                            HorizontalAlignment="Left"
                            Background="#FFEAF4FF"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="48">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="34"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Text="{Binding CurrentUserInitial}" />
                    </Border>

                    <TextBlock Margin="0,18,0,0"
                               Text="{Binding CurrentUserDisplay}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding CurrentUserRole}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding WorkspaceLabel}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" />

                    <Button Margin="0,24,0,0"
                            Style="{StaticResource NeutralButtonStyle}"
                            Command="{Binding ReturnToDashboardCommand}"
                            Content="Back to dashboard" />
                    <Button Margin="0,10,0,0"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding LogoutCommand}"
                            Content="Log out" />
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource ModalSectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Account"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,18,0,0"
                                       Text="Display name"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding CurrentUserDisplay}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,18,0,0"
                                       Text="Role"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding CurrentUserRole}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,18,0,0"
                                       Text="Workspace"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding WorkspaceLabel}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,18,0,0"
                            Style="{StaticResource ModalSectionBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Session"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,18,0,0"
                                       Text="Connection mode"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding CurrentModeDisplay}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,18,0,0"
                                       Text="Application"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding ApplicationTitle}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding ApplicationSubtitle}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Margin="0,18,0,0"
                                       Text="Support"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding SupportSummary}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
