<UserControl x:Class="School_Management_System.Wpf.Views.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,0" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="MetricNoteStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Analytics"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding AnalyticsSummary}"
                                   FontSize="14"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding LastUpdatedText}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Margin="18,0,0,0"
                            VerticalAlignment="Top"
                            Style="{StaticResource NeutralButtonStyle}"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Text="&#xE72C;" />
                            <TextBlock Margin="8,0,0,0"
                                       Text="Refresh" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <UniformGrid Margin="0,18,0,0"
                         Columns="3"
                         Rows="2">
                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Students" />
                        <TextBlock Style="{StaticResource MetricValueStyle}"
                                   Text="{Binding StudentsCount, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource MetricNoteStyle}" Text="Active learner records" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Faculty" />
                        <TextBlock Style="{StaticResource MetricValueStyle}"
                                   Text="{Binding FacultyCount, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource MetricNoteStyle}" Text="Teaching staff members" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Courses" />
                        <TextBlock Style="{StaticResource MetricValueStyle}"
                                   Text="{Binding CoursesCount, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource MetricNoteStyle}" Text="Academic programs" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Subjects" />
                        <TextBlock Style="{StaticResource MetricValueStyle}"
                                   Text="{Binding SubjectsCount, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource MetricNoteStyle}" Text="Catalog subjects" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Departments" />
                        <TextBlock Style="{StaticResource MetricValueStyle}"
                                   Text="{Binding DepartmentsCount, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource MetricNoteStyle}" Text="Configured departments" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCardStyle}"
                        Background="#FFF1F8FF">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricLabelStyle}" Text="Total Records" />
                        <TextBlock Style="{StaticResource MetricValueStyle}"
                                   Text="{Binding TotalRecordsCount, StringFormat={}{0:N0}}" />
                        <TextBlock Style="{StaticResource MetricNoteStyle}"
                                   Text="{Binding ConnectionModeDisplay, StringFormat=Database profile: {0}}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
