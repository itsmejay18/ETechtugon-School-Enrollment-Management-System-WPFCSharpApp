<UserControl x:Class="School_Management_System.Wpf.Views.Faculty.FacultyDirectoryView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="DetailCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF8FBFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="MinWidth" Value="260" />
            <Setter Property="MaxWidth" Value="470" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Faculty directory"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="Faculty profiles and teaching assignments now open inside the same centered overlay pattern instead of occupying a second fixed column."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>

                    <WrapPanel Grid.Row="1"
                               Margin="0,16,0,0">
                        <TextBox Width="260"
                                 MinWidth="220"
                                 Margin="0,0,10,10"
                                 Style="{StaticResource ToolbarTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Margin="0,0,10,10"
                                Style="{StaticResource NeutralButtonStyle}"
                                Command="{Binding SearchCommand}"
                                Content="Search" />
                        <Button Margin="0,0,10,10"
                                Style="{StaticResource NeutralButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                Content="Refresh" />
                        <Button Margin="0,0,0,10"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding OpenDetailsCommand}"
                                Content="Open profile" />
                    </WrapPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="{Binding RecordCountText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding StatusMessage}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              AutoGenerateColumns="True"
                              ItemsSource="{Binding Records}"
                              SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                              MouseDoubleClick="RecordsGrid_OnMouseDoubleClick" />
                </Grid>
            </Grid>
        </Border>

        <Popup IsOpen="{Binding IsDetailsModalOpen, Mode=OneWay}"
               AllowsTransparency="True"
               Placement="Center"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               PopupAnimation="Fade"
               StaysOpen="True">
            <Border Margin="40"
                    MaxWidth="1200"
                    MaxHeight="820"
                    Style="{StaticResource ModalCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="30,28,30,24"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="84"
                                    Height="84"
                                    CornerRadius="24"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    Background="#FFF4F9FF">
                                <Grid>
                                    <Image Source="{Binding FacultyPhoto}"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding HasPhoto, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="34"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Text="&#xE77B;"
                                               Visibility="{Binding HasPhoto, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding DetailsModalTitle}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding DetailsModalSubtitle}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Margin="18,0,0,0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource ModalCloseButtonStyle}"
                                    Command="{Binding CloseDetailsCommand}" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  Padding="30,24,30,30"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource ModalSectionBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Profile fields"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="Faculty details stay inside the modal so the table workspace keeps its full width."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                    <ItemsControl Margin="0,18,0,0"
                                                  ItemsSource="{Binding DetailFields}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource DetailCardStyle}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource PrimaryBrush}" />
                                                        <TextBlock Margin="0,6,0,0"
                                                                   Text="{Binding Value}"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{StaticResource TextBrush}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModalSectionBorderStyle}"
                                    Margin="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Teaching assignments"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Text="Assignment rows are loaded from the class schedule table for the selected faculty member."
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>

                                    <DataGrid Grid.Row="1"
                                              Height="280"
                                              AutoGenerateColumns="True"
                                              ItemsSource="{Binding Assignments}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
