<Window x:Class="School_Management_System.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vmCalendar="clr-namespace:School_Management_System.Wpf.ViewModels.Calendar"
        xmlns:vmEnrollment="clr-namespace:School_Management_System.Wpf.ViewModels.Enrollment"
        xmlns:vmFaculty="clr-namespace:School_Management_System.Wpf.ViewModels.Faculty"
        xmlns:vmSchedule="clr-namespace:School_Management_System.Wpf.ViewModels.Schedule"
        xmlns:vmSettings="clr-namespace:School_Management_System.Wpf.ViewModels.Settings"
        xmlns:vmShared="clr-namespace:School_Management_System.Wpf.ViewModels.Shared"
        xmlns:vmStudents="clr-namespace:School_Management_System.Wpf.ViewModels.Students"
        xmlns:vm="clr-namespace:School_Management_System.Wpf.ViewModels"
        xmlns:viewsCalendar="clr-namespace:School_Management_System.Wpf.Views.Calendar"
        xmlns:viewsEnrollment="clr-namespace:School_Management_System.Wpf.Views.Enrollment"
        xmlns:viewsFaculty="clr-namespace:School_Management_System.Wpf.Views.Faculty"
        xmlns:viewsSchedule="clr-namespace:School_Management_System.Wpf.Views.Schedule"
        xmlns:viewsSettingsExtra="clr-namespace:School_Management_System.Wpf.Views.Settings"
        xmlns:viewsShared="clr-namespace:School_Management_System.Wpf.Views.Shared"
        xmlns:viewsStudents="clr-namespace:School_Management_System.Wpf.Views.Students"
        xmlns:views="clr-namespace:School_Management_System.Wpf.Views"
        Title="School Enrollment Management System"
        Width="1500"
        Height="920"
        MinWidth="1240"
        MinHeight="780"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderThickness="0"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate DataType="{x:Type vm:DashboardHomeViewModel}">
            <views:DashboardHomeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}">
            <views:AnalyticsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProfileWorkspaceViewModel}">
            <views:ProfileWorkspaceView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ModulePlaceholderViewModel}">
            <views:ModulePlaceholderView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmStudents:StudentDirectoryViewModel}">
            <viewsStudents:StudentDirectoryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmFaculty:FacultyDirectoryViewModel}">
            <viewsFaculty:FacultyDirectoryView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmSchedule:ScheduleBoardViewModel}">
            <viewsSchedule:ScheduleBoardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmEnrollment:EnrollmentWorkspaceViewModel}">
            <viewsEnrollment:EnrollmentWorkspaceView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmCalendar:AcademicCalendarViewModel}">
            <viewsCalendar:AcademicCalendarView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmShared:DataTableWorkspaceViewModel}">
            <viewsShared:DataTableWorkspaceView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vmSettings:CurriculumExplorerViewModel}">
            <viewsSettingsExtra:CurriculumExplorerView />
        </DataTemplate>

        <LinearGradientBrush x:Key="SchoolShellHeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF0F4E8C" Offset="0" />
            <GradientStop Color="#FF1D5FA8" Offset="0.55" />
            <GradientStop Color="#FF3686D0" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseTitleBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFE81123" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FF15436E" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFC8DCF0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="MinWidth" Value="102" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFF4FAFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF6BAEE4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderActionButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF1D5FA8" />
            <Setter Property="BorderBrush" Value="#FF1D5FA8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF0F4E8C" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF0F4E8C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="#FF15436E" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFC8DCF0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFF4FAFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF6BAEE4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderPrimaryIconButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderIconButtonStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF1D5FA8" />
            <Setter Property="BorderBrush" Value="#FF1D5FA8" />
        </Style>

        <Style x:Key="SidebarCircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#FF7A8596" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFD6E0EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="28">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFF7FBFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#FF7CB6E8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarCircleIndicatorStyle" TargetType="Border">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FFD6E0EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="28" />
        </Style>

        <Geometry x:Key="NotificationBellGeometry">M12,2 C9.79,2 8,3.79 8,6 L8,7.09 C8,7.57 7.82,8.04 7.5,8.41 L6.17,10 L17.83,10 L16.5,8.41 C16.18,8.04 16,7.57 16,7.09 L16,6 C16,3.79 14.21,2 12,2 Z M6,11 C5.45,11 5,11.45 5,12 C5,12.55 5.45,13 6,13 L18,13 C18.55,13 19,12.55 19,12 C19,11.45 18.55,11 18,11 L6,11 Z M10,16 C10,17.1 10.9,18 12,18 C13.1,18 14,17.1 14,16 L10,16 Z</Geometry>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="94" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SchoolShellHeaderBrush}"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
            <Grid Margin="16,10,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Grid Width="260"
                          Height="72"
                          VerticalAlignment="Center">
                        <Image x:Name="ShellBrandLogoImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right"
                            Margin="12,0,12,0">
                    <Border Margin="0,0,10,0"
                            Padding="14,8"
                            CornerRadius="16"
                            Background="#18FFFFFF"
                            BorderBrush="#2CFFFFFF"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentUserDisplay}"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding CurrentModeDisplay}"
                                       Foreground="#EAF6FF"
                                       FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding ShowNotificationsCommand}"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            ToolTip="Notifications">
                        <Grid Width="24"
                              Height="24">
                            <Viewbox Width="20"
                                     Height="20"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Path Data="{StaticResource NotificationBellGeometry}"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform" />
                            </Viewbox>
                            <Border Width="20"
                                    Height="20"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,-8,-10,0"
                                    Background="#FFE74C3C"
                                    BorderBrush="White"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Visibility="{Binding HasNotifications, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           Text="{Binding NotificationBadgeText}" />
                            </Border>
                        </Grid>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                    <Button Width="38"
                            Height="30"
                            Margin="0,0,4,0"
                            Click="MinimizeButton_OnClick"
                            Focusable="False"
                            Style="{StaticResource TitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Text="&#xE921;" />
                    </Button>

                    <Button Width="38"
                            Height="30"
                            Margin="0,0,4,0"
                            Click="MaximizeRestoreButton_OnClick"
                            Focusable="False"
                            Style="{StaticResource TitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="MaximizeRestoreIcon"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Text="&#xE922;" />
                    </Button>

                    <Button Width="38"
                            Height="30"
                            Click="CloseButton_OnClick"
                            Focusable="False"
                            Style="{StaticResource CloseTitleBarButtonStyle}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   Text="&#xE8BB;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Background="#FFF4F9FF">
            <ContentControl x:Name="ShellContentPresenter"
                            Content="{Binding CurrentModule}"
                            ClipToBounds="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Margin" Value="98,22,22,22" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveModuleKey}" Value="dashboard">
                                <Setter Property="Margin" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

            <Grid Panel.ZIndex="20"
                  Margin="14,18,0,18"
                  HorizontalAlignment="Left">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveModuleKey}" Value="dashboard">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Button Command="{Binding ShowDashboardCommand}"
                            ToolTip="Dashboard">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarCircleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveModuleKey}" Value="dashboard">
                                        <Setter Property="Background" Value="#FFE53935" />
                                        <Setter Property="BorderBrush" Value="#FFE53935" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Text="&#xE80F;" />
                    </Button>

                    <Button Command="{Binding ShowStudentsCommand}"
                            ToolTip="Student Profile"
                            Visibility="{Binding CanAccessStudents, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarCircleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveModuleKey}" Value="students">
                                        <Setter Property="Background" Value="#FFE53935" />
                                        <Setter Property="BorderBrush" Value="#FFE53935" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Text="&#xE716;" />
                    </Button>

                    <Button Command="{Binding ShowFacultyCommand}"
                            ToolTip="Faculty"
                            Visibility="{Binding CanAccessFaculty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarCircleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveModuleKey}" Value="faculty">
                                        <Setter Property="Background" Value="#FFE53935" />
                                        <Setter Property="BorderBrush" Value="#FFE53935" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Text="&#xE77B;" />
                    </Button>

                    <Button Command="{Binding ShowEnrollmentCommand}"
                            ToolTip="Enrollment"
                            Visibility="{Binding CanAccessEnrollment, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarCircleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveModuleKey}" Value="enrollment">
                                        <Setter Property="Background" Value="#FFE53935" />
                                        <Setter Property="BorderBrush" Value="#FFE53935" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Text="&#xE8C8;" />
                    </Button>

                    <Button Command="{Binding ShowScheduleCommand}"
                            ToolTip="Schedule"
                            Visibility="{Binding CanAccessSchedule, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarCircleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveModuleKey}" Value="schedule">
                                        <Setter Property="Background" Value="#FFE53935" />
                                        <Setter Property="BorderBrush" Value="#FFE53935" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Text="&#xE787;" />
                    </Button>

                    <Button Command="{Binding ShowCalendarCommand}"
                            ToolTip="Calendar"
                            Visibility="{Binding CanAccessCalendar, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarCircleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveModuleKey}" Value="calendar">
                                        <Setter Property="Background" Value="#FFE53935" />
                                        <Setter Property="BorderBrush" Value="#FFE53935" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Text="&#xE163;" />
                    </Button>

                    <Button Command="{Binding ShowAnalyticsCommand}"
                            ToolTip="Analytics"
                            Visibility="{Binding CanAccessAnalytics, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarCircleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveModuleKey}" Value="analytics">
                                        <Setter Property="Background" Value="#FFE53935" />
                                        <Setter Property="BorderBrush" Value="#FFE53935" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Text="&#xE9D2;" />
                    </Button>

                    <Button Command="{Binding ShowCurriculumSettingsCommand}"
                            ToolTip="Curriculum settings"
                            Visibility="{Binding CanAccessCurriculumSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarCircleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveModuleKey}" Value="curriculum-settings">
                                        <Setter Property="Background" Value="#FFE53935" />
                                        <Setter Property="BorderBrush" Value="#FFE53935" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Text="&#xE7BE;" />
                    </Button>

                    <Button Command="{Binding ShowSettingsCommand}"
                            ToolTip="Settings"
                            Visibility="{Binding CanAccessSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarCircleButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveModuleKey}" Value="settings">
                                        <Setter Property="Background" Value="#FFE53935" />
                                        <Setter Property="BorderBrush" Value="#FFE53935" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Text="&#xE713;" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,12,0,0">
                    <Button Command="{Binding ShowProfileCommand}"
                            Margin="0,0,0,10"
                            ToolTip="{Binding CurrentUserDisplay}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarCircleButtonStyle}">
                                <Setter Property="Foreground" Value="#FF1D5FA8" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveModuleKey}" Value="profile">
                                        <Setter Property="Background" Value="#FFE53935" />
                                        <Setter Property="BorderBrush" Value="#FFE53935" />
                                        <Setter Property="Foreground" Value="White" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Text="&#xE77B;" />
                    </Button>

                    <Button Command="{Binding LogoutCommand}"
                            Margin="0"
                            Style="{StaticResource SidebarCircleButtonStyle}"
                            ToolTip="Log out">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="#FFE53935"
                                   Text="&#xE8AC;" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.RowSpan="2"
              Panel.ZIndex="40"
              Visibility="{Binding IsModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="{StaticResource ModalOverlayBrush}" />
        </Grid>

        <Grid Grid.RowSpan="2"
              Panel.ZIndex="50"
              Visibility="{Binding IsNotificationModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="700"
                    MaxHeight="760"
                    Style="{StaticResource ModalCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="30,26,30,20"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Notifications"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="Recent transaction activity from the active school database."
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource ModalCloseButtonStyle}"
                                    Command="{Binding CloseNotificationsCommand}" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  Padding="30,22,30,30"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Margin="0,18,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="No recent transactions yet.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNotifications}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding Notifications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,16"
                                                Padding="18"
                                                Background="#FFF8FBFF"
                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                CornerRadius="20">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Width="44"
                                                        Height="44"
                                                        VerticalAlignment="Top"
                                                        Background="#FFEAF4FF"
                                                        CornerRadius="16">
                                                    <Viewbox Width="20"
                                                             Height="20"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center">
                                                        <Path Data="{StaticResource NotificationBellGeometry}"
                                                              Fill="{StaticResource PrimaryBrush}"
                                                              Stretch="Uniform" />
                                                    </Viewbox>
                                                </Border>

                                                <StackPanel Grid.Column="1"
                                                            Margin="16,0,0,0">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               Text="{Binding Subtitle}"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource MutedTextBrush}" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               Text="{Binding Message}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource MutedTextBrush}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="2"
                                                           Margin="18,0,0,0"
                                                           FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding RelativeTime}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
