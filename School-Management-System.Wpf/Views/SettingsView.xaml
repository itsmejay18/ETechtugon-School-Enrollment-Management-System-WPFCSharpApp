<UserControl x:Class="School_Management_System.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewsCourses="clr-namespace:School_Management_System.Wpf.Views.Courses">
    <UserControl.Resources>
        <DataTemplate x:Key="PlaceholderTemplate">
            <ContentControl Content="{Binding}" />
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Settings"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,8,0,0"
                           Text="The WPF app now keeps academic setup inside Settings, matching the WinForms workflow."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>

            <TabControl Grid.Row="1">
                <TabItem Header="System">
                    <ContentControl Content="{Binding SystemModule}" />
                </TabItem>
                <TabItem Header="Database">
                    <ContentControl Content="{Binding DatabaseModule}" />
                </TabItem>
                <TabItem Header="Departments">
                    <ContentControl Content="{Binding DepartmentsModule}" />
                </TabItem>
                <TabItem Header="Courses">
                    <viewsCourses:CourseManagementView DataContext="{Binding CourseManagement}" />
                </TabItem>
                <TabItem Header="Year Levels">
                    <ContentControl Content="{Binding YearLevelsModule}" />
                </TabItem>
                <TabItem Header="Sections">
                    <ContentControl Content="{Binding SectionsModule}" />
                </TabItem>
                <TabItem Header="Subjects">
                    <ContentControl Content="{Binding SubjectsModule}" />
                </TabItem>
                <TabItem Header="Curriculum">
                    <ContentControl Content="{Binding CurriculumModule}" />
                </TabItem>
                <TabItem Header="User Management">
                    <ContentControl Content="{Binding UserManagementModule}" />
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
