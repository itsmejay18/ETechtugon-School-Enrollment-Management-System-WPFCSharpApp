<UserControl x:Class="School_Management_System.Wpf.Views.Courses.CourseManagementView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="104" />
        </Style>

        <Style x:Key="ToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="104" />
        </Style>

        <Style x:Key="ToolbarDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="MinWidth" Value="104" />
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Padding="0,0,24,0"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Course CRUD"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,8,0,0"
                           Text="Manage course records from this sidebar, then use the modal editor for the selected item."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />

                <TextBlock Margin="0,28,0,8"
                           Text="Find courses"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}" />
                <TextBox VerticalContentAlignment="Center"
                         Style="{StaticResource FieldTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <Button Margin="0,12,0,0"
                        Content="Refresh list"
                        Style="{StaticResource NeutralButtonStyle}"
                        Command="{Binding RefreshCommand}" />
                <Button Margin="0,18,0,0"
                        Content="Add course"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddCommand}" />
                <Button Margin="0,10,0,0"
                        Content="Edit selected"
                        Style="{StaticResource NeutralButtonStyle}"
                        Command="{Binding EditCommand}" />
                <Button Margin="0,10,0,0"
                        Content="Delete selected"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding DeleteCommand}" />

                <Border Margin="0,24,0,18"
                        Height="1"
                        Background="{StaticResource BorderBrushSoft}" />

                <TextBlock Text="Selected course"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock Margin="0,6,0,0"
                           Text="{Binding SelectedCourse.CourseCode, TargetNullValue=No course selected}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,6,0,0"
                           Text="{Binding SelectedCourse.CourseName}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />

                <TextBlock Margin="0,22,0,0"
                           Text="Workspace status"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock Margin="0,6,0,0"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Courses"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Course maintenance now uses a left CRUD sidebar with the editor modal kept in the same workspace."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           VerticalAlignment="Top"
                           Text="Modal CRUD editor"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}" />
            </Grid>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Courses}"
                      SelectedItem="{Binding SelectedCourse}"
                      MouseDoubleClick="CoursesGrid_OnMouseDoubleClick"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      IsReadOnly="True"
                      AlternatingRowBackground="#FFF8FAFC"
                      BorderThickness="1"
                      BorderBrush="{StaticResource BorderBrushSoft}"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding CourseCode}" Width="140" />
                    <DataGridTextColumn Header="Course Name" Binding="{Binding CourseName}" Width="240" />
                    <DataGridTextColumn Header="Department" Binding="{Binding DepartmentName}" Width="200" />
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2"
                       Margin="0,18,0,0"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Foreground="#166534" />
        </Grid>

        <Popup IsOpen="{Binding IsEditorModalOpen, Mode=OneWay}"
               AllowsTransparency="True"
               Placement="Center"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               PopupAnimation="Fade"
               StaysOpen="True">
            <Border Margin="44"
                    MaxWidth="980"
                    MaxHeight="780"
                    Style="{StaticResource ModalCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="30,28,30,24"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding EditorModalTitle}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding EditorModalSubtitle}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Margin="18,0,0,0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource ModalCloseButtonStyle}"
                                    Command="{Binding CancelCommand}" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  Padding="30,24,30,24"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Course Code"
                                           Margin="0,0,0,8"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                         IsReadOnly="{Binding IsEditorReadOnly}"
                                         Text="{Binding CourseCode, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0">
                                <TextBlock Text="Course Name"
                                           Margin="0,0,0,8"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                         IsReadOnly="{Binding IsEditorReadOnly}"
                                         Text="{Binding CourseName, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0,18,0,0">
                                <TextBlock Text="Department"
                                           Margin="0,0,0,8"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <ComboBox Style="{StaticResource FieldComboBoxStyle}"
                                          IsEnabled="{Binding IsEditorActive}"
                                          ItemsSource="{Binding Departments}"
                                          SelectedItem="{Binding SelectedDepartment}"
                                          DisplayMemberPath="DepartmentName" />
                            </StackPanel>

                            <Border Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Margin="0,18,0,0"
                                    Style="{StaticResource ModalSectionBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Editor mode"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Text="{Binding EditorModeText}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="3"
                                        Grid.ColumnSpan="2"
                                        Margin="0,18,0,0">
                                <TextBlock Text="Description"
                                           Margin="0,0,0,8"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBox Style="{StaticResource FieldTextBoxStyle}"
                                         Height="260"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         IsReadOnly="{Binding IsEditorReadOnly}"
                                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Padding="24"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}" />

                            <StackPanel Grid.Column="1"
                                        Margin="18,0,0,0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Margin="0,0,10,0"
                                        Style="{StaticResource NeutralButtonStyle}"
                                        Command="{Binding CancelCommand}"
                                        Content="Cancel" />
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveCommand}"
                                        Content="Save" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
