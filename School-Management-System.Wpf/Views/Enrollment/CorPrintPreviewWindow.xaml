<Window x:Class="School_Management_System.Wpf.Views.Enrollment.CorPrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Certificate of Registration Preview"
        Width="1100"
        Height="820"
        MinWidth="920"
        MinHeight="680"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Border Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource CardBorderStyle}"
                    Padding="18">
                <StackPanel>
                    <TextBlock Text="Certificate of Registration Preview"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Review the COR before sending it to the printer."
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,18,0,18"
                    Style="{StaticResource CardBorderStyle}"
                    Padding="12">
                <FlowDocumentReader x:Name="PreviewViewer"
                                    ViewingMode="Page"
                                    IsFindEnabled="True" />
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Margin="0,0,10,0"
                        Style="{StaticResource NeutralButtonStyle}"
                        Click="CloseButton_OnClick"
                        Content="Close" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Click="PrintButton_OnClick"
                        Content="Print" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
