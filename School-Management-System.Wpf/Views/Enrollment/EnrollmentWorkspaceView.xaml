<UserControl x:Class="School_Management_System.Wpf.Views.Enrollment.EnrollmentWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="SummaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Padding" Value="24,12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SummarySecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Padding" Value="22,12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Enrollment workspace" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,8,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.92*" />
                    <ColumnDefinition Width="1.08*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Student selection" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />

                        <Grid Grid.Row="1" Margin="0,14,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Margin="0,0,10,0" Style="{StaticResource ToolbarTextBoxStyle}" Text="{Binding StudentSearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Style="{StaticResource NeutralButtonStyle}" Command="{Binding SearchStudentsCommand}" Content="Search" />
                        </Grid>

                        <DataGrid Grid.Row="2" AutoGenerateColumns="True" ItemsSource="{Binding StudentRecords}" SelectedItem="{Binding SelectedStudent, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="18,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse, Mode=TwoWay}" DisplayMemberPath="DisplayName" Margin="0,0,10,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding AcademicYears}" SelectedItem="{Binding SelectedAcademicYear, Mode=TwoWay}" DisplayMemberPath="DisplayName" Margin="0,0,10,0" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding YearLevels}" SelectedItem="{Binding SelectedYearLevel, Mode=TwoWay}" DisplayMemberPath="DisplayName" Margin="0,0,10,0" />
                                <ComboBox Grid.Column="3" ItemsSource="{Binding Semesters}" SelectedItem="{Binding SelectedSemester, Mode=TwoWay}" DisplayMemberPath="DisplayName" />
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=TwoWay}" DisplayMemberPath="DisplayName" Margin="0,0,10,0" />
                                <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0" Content="By section" IsChecked="{Binding UseSectionMode, Mode=TwoWay}" />
                                <Button Grid.Column="2" Margin="0,0,10,0" Style="{StaticResource NeutralButtonStyle}" Command="{Binding LoadSubjectsCommand}" Content="Load subjects" />
                                <Button Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RefreshLookupsCommand}" Content="Refresh lookups" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="0,18,0,18" Style="{StaticResource CardBorderStyle}" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Available subjects" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Margin="0,6,0,0" Text="{Binding TotalUnitsText}" Foreground="{StaticResource PrimaryBrush}" />
                            </StackPanel>

                            <DataGrid Grid.Row="1" AutoGenerateColumns="False" ItemsSource="{Binding AvailableSubjects}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay}" Header="Pick" Width="70" />
                                    <DataGridTextColumn Binding="{Binding SubjectCode}" Header="Code" Width="110" />
                                    <DataGridTextColumn Binding="{Binding SubjectName}" Header="Subject" Width="*" />
                                    <DataGridTextColumn Binding="{Binding Units}" Header="Units" Width="80" />
                                    <DataGridTextColumn Binding="{Binding ScheduleText}" Header="Schedule" Width="220" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedStudentSummary}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                                <TextBlock Margin="0,10,0,0" Text="{Binding SummaryText}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="18,0,0,0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button Margin="0,0,10,0"
                                        Style="{StaticResource SummarySecondaryActionButtonStyle}"
                                        Command="{Binding PrintCorCommand}"
                                        Content="Print COR" />
                                <Button Style="{StaticResource SummaryActionButtonStyle}"
                                        Command="{Binding SaveEnrollmentCommand}"
                                        Content="Save enrollment" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
