<UserControl x:Class="School_Management_System.Wpf.Views.Enrollment.EnrollmentWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:School_Management_System.Wpf.Services">
    <UserControl.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="services:DataGridColumnDisplay.UseCompactColumns" Value="True" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="SummaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="180" />
            <Setter Property="Padding" Value="24,12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SummarySecondaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Padding" Value="22,12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid>
    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Enrollment workspace" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,8,0,0" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.92*" />
                    <ColumnDefinition Width="1.08*" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Student selection" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />

                    <Grid Grid.Row="1" Margin="0,14,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Margin="0,0,10,0" Style="{StaticResource ToolbarTextBoxStyle}" Text="{Binding StudentSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Margin="0,0,10,0" Style="{StaticResource NeutralButtonStyle}" Command="{Binding SearchStudentsCommand}" Content="Search" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding OpenStudentProfileCommand}" Content="Open profile" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="2" AutoGenerateColumns="True" ItemsSource="{Binding StudentRecords}" SelectedItem="{Binding SelectedStudent, Mode=TwoWay}" />
                </Grid>

                <Grid Grid.Column="1" Margin="18,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <WrapPanel>
                            <ComboBox Width="200"
                                      MinWidth="180"
                                      Margin="0,0,10,10"
                                      ItemsSource="{Binding Courses}"
                                      SelectedItem="{Binding SelectedCourse, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" />
                            <ComboBox Width="200"
                                      MinWidth="180"
                                      Margin="0,0,10,10"
                                      ItemsSource="{Binding AcademicYears}"
                                      SelectedItem="{Binding SelectedAcademicYear, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" />
                            <ComboBox Width="200"
                                      MinWidth="180"
                                      Margin="0,0,10,10"
                                      ItemsSource="{Binding YearLevels}"
                                      SelectedItem="{Binding SelectedYearLevel, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" />
                            <ComboBox Width="200"
                                      MinWidth="180"
                                      Margin="0,0,0,10"
                                      ItemsSource="{Binding Semesters}"
                                      SelectedItem="{Binding SelectedSemester, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" />
                        </WrapPanel>

                        <WrapPanel Margin="0,4,0,0">
                            <ComboBox Width="260"
                                      MinWidth="220"
                                      Margin="0,0,10,10"
                                      ItemsSource="{Binding Sections}"
                                      SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                                      DisplayMemberPath="DisplayName" />
                            <ComboBox Width="220"
                                      MinWidth="200"
                                      Margin="0,0,10,10"
                                      ItemsSource="{Binding ScholarshipOptions}"
                                      SelectedItem="{Binding SelectedScholarship, Mode=TwoWay}" />
                            <CheckBox VerticalAlignment="Center"
                                      Margin="0,10,14,0"
                                      Content="By section"
                                      IsChecked="{Binding UseSectionMode, Mode=TwoWay}" />
                            <Button Margin="0,0,10,10"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding EnrollAllCommand}"
                                    Content="Enroll all" />
                            <Button Margin="0,0,10,10"
                                    Style="{StaticResource NeutralButtonStyle}"
                                    Command="{Binding LoadSubjectsCommand}"
                                    Content="Load subjects" />
                            <Button Margin="0,0,0,10"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding RefreshLookupsCommand}"
                                    Content="Refresh lookups" />
                        </WrapPanel>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,18,0,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="170" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Available subjects" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding TotalUnitsText}" Foreground="{StaticResource PrimaryBrush}" />
                        </StackPanel>

                        <DataGrid Grid.Row="1" AutoGenerateColumns="False" ItemsSource="{Binding AvailableSubjects}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay}" Header="Pick" Width="70" />
                                <DataGridTextColumn Binding="{Binding SubjectCode}" Header="Code" Width="110" />
                                <DataGridTextColumn Binding="{Binding SubjectName}" Header="Subject" Width="*" />
                                <DataGridTextColumn Binding="{Binding Units}" Header="Units" Width="80" />
                                <DataGridTextColumn Binding="{Binding CapacityText}" Header="Capacity" Width="110" />
                                <DataGridTextColumn Binding="{Binding EligibilityStatus}" Header="Status" Width="110" />
                                <DataGridTextColumn Binding="{Binding ScheduleText}" Header="Schedule" Width="220" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Margin="0,14,0,8">
                            <TextBlock Text="Enrolled subjects"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" />
                        </StackPanel>

                        <DataGrid Grid.Row="3"
                                  AutoGenerateColumns="True"
                                  ItemsSource="{Binding CurrentEnrolledSubjects}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedStudentSummary}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding SelectedStudentType}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Margin="0,10,0,0" Text="{Binding SummaryText}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <WrapPanel Grid.Column="1"
                                   Margin="18,0,0,0"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center">
                            <Button Margin="0,0,10,0"
                                    Style="{StaticResource SummarySecondaryActionButtonStyle}"
                                    Command="{Binding PrintCorCommand}"
                                    Content="Print COR" />
                            <Button Margin="0,0,0,10"
                                    Style="{StaticResource SummaryActionButtonStyle}"
                                    Command="{Binding SaveEnrollmentCommand}"
                                    Content="Save enrollment" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>

        <Popup IsOpen="{Binding IsStudentProfileOpen, Mode=OneWay}"
               AllowsTransparency="True"
               Placement="Center"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               PopupAnimation="Fade"
               StaysOpen="True">
            <Border Margin="44"
                    MaxWidth="1100"
                    MaxHeight="780"
                    Style="{StaticResource ModalCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Padding="30,28,30,24"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedStudentSummary}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding SelectedStudentType}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource ModalCloseButtonStyle}"
                                    Command="{Binding CloseStudentProfileCommand}" />
                        </Grid>
                    </Border>
                    <TabControl Grid.Row="1"
                                Margin="24,18,24,24">
                        <TabItem Header="Semester Records">
                            <DataGrid AutoGenerateColumns="True" ItemsSource="{Binding ProfileEnrollmentHistory}" />
                        </TabItem>
                        <TabItem Header="Completed">
                            <DataGrid AutoGenerateColumns="True" ItemsSource="{Binding ProfileCompletedSubjects}" />
                        </TabItem>
                        <TabItem Header="Failed">
                            <DataGrid AutoGenerateColumns="True" ItemsSource="{Binding ProfileFailedSubjects}" />
                        </TabItem>
                        <TabItem Header="Remaining">
                            <DataGrid AutoGenerateColumns="True" ItemsSource="{Binding ProfileRemainingSubjects}" />
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
