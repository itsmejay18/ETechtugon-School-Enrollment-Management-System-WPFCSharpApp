<Window x:Class="School_Management_System.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="School Enrollment Management System - Login"
        Width="1280"
        Height="820"
        MinWidth="1024"
        MinHeight="680"
        ResizeMode="CanMinimize"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <LinearGradientBrush x:Key="LoginHeroBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF2C3E50" Offset="0" />
            <GradientStop Color="#FF31485F" Offset="0.55" />
            <GradientStop Color="#FF253646" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="HeroTextSoftBrush" Color="#FFD7E5F0" />
        <SolidColorBrush x:Key="PanelSurfaceBrush" Color="#FFF8FBFE" />
        <SolidColorBrush x:Key="FieldSurfaceBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#FFD3DAE2" />
        <SolidColorBrush x:Key="ConnectionInfoBrush" Color="#FFF4F8FC" />
        <SolidColorBrush x:Key="ConnectionInfoBorderBrush" Color="#FFD6E5F2" />
        <SolidColorBrush x:Key="SuccessSurfaceBrush" Color="#FFECFDF3" />
        <SolidColorBrush x:Key="SuccessBorderBrush" Color="#FFA7F3D0" />
        <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#FFFEF2F2" />
        <SolidColorBrush x:Key="ErrorBorderBrush" Color="#FFFECACA" />

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="{StaticResource FieldSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="{StaticResource FieldSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="FieldComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="{StaticResource FieldSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="LoginPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryBrushDark}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrushDark}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LoginSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource LoginPrimaryButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF6FAFD" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border Background="White"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="1"
                CornerRadius="30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.08*" MinWidth="460" />
                    <ColumnDefinition Width="0.92*" MinWidth="430" />
                </Grid.ColumnDefinitions>

                <Border CornerRadius="30,0,0,30"
                        Background="{StaticResource LoginHeroBrush}">
                    <Grid Margin="42">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="96"
                                    Height="96"
                                    CornerRadius="24"
                                    Background="White">
                                <Image x:Name="BrandLogoImage"
                                       Stretch="Uniform"
                                       Margin="8" />
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="18,8,0,0">
                                <TextBlock Text="School Enrollment Management System"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Foreground="White" />
                                <TextBlock Text="Enrollment, records, and academic administration"
                                           Margin="0,6,0,0"
                                           FontSize="15"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource HeroTextSoftBrush}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1"
                              MaxWidth="520"
                              Margin="10,18,52,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Cleaner sign-in, same school workflow."
                                       TextWrapping="Wrap"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       LineHeight="42"
                                       Foreground="White" />

                            <TextBlock Grid.Row="1"
                                       Margin="0,16,0,0"
                                       Text="Use the same accounts, quick presets, and database profiles from the existing system while moving into the WPF shell."
                                       TextWrapping="Wrap"
                                       FontSize="16"
                                       LineHeight="26"
                                       Foreground="{StaticResource HeroTextSoftBrush}" />

                            <StackPanel Grid.Row="2"
                                        Margin="0,24,0,0">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource AccentBrush}"
                                            CornerRadius="3" />
                                    <StackPanel Grid.Column="1"
                                                Margin="14,0,0,0">
                                        <TextBlock Text="Quick presets stay available"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                        <TextBlock Text="Admin, Faculty, and Registrar credentials can still prefill instantly."
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   FontSize="13.5"
                                                   Foreground="{StaticResource HeroTextSoftBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#FF5DADE2"
                                            CornerRadius="3" />
                                    <StackPanel Grid.Column="1"
                                                Margin="14,0,0,0">
                                        <TextBlock Text="Database profile stays visible"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                        <TextBlock Text="Choose Local, Network, Wi-Fi, or Online before you continue to the dashboard."
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   FontSize="13.5"
                                                   Foreground="{StaticResource HeroTextSoftBrush}" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="#FF85C1E9"
                                            CornerRadius="3" />
                                    <StackPanel Grid.Column="1"
                                                Margin="14,0,0,0">
                                        <TextBlock Text="Simpler layout, better focus"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="White" />
                                        <TextBlock Text="The form is quieter now, with clearer grouping and less visual clutter."
                                                   Margin="0,6,0,0"
                                                   TextWrapping="Wrap"
                                                   FontSize="13.5"
                                                   Foreground="{StaticResource HeroTextSoftBrush}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Border Grid.Row="4"
                                    Margin="0,20,0,0"
                                    Padding="18"
                                    Background="#1AFFFFFF"
                                    BorderBrush="#33FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="18">
                                <StackPanel>
                                    <TextBlock Text="License and Contact"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="White" />

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Serial Number"
                                                   FontSize="13.5"
                                                   Foreground="{StaticResource HeroTextSoftBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ClientSerialNumber}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="White" />
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Gmail"
                                                   FontSize="13.5"
                                                   Foreground="{StaticResource HeroTextSoftBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SupportGmail}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="White" />
                                    </Grid>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="128" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Phone Number"
                                                   FontSize="13.5"
                                                   Foreground="{StaticResource HeroTextSoftBrush}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SupportPhoneNumber}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   Foreground="White" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource PanelSurfaceBrush}"
                        CornerRadius="0,30,30,0">
                    <Grid>
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="560"
                                Margin="28"
                                Padding="30"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="24">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18"
                                                  ShadowDepth="4"
                                                  Opacity="0.12"
                                                  Color="#FF2C3E50" />
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Welcome back"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" />

                                <TextBlock Grid.Row="1"
                                           Margin="0,10,0,0"
                                           Text="Sign in with a quick preset or your existing school account."
                                           TextWrapping="Wrap"
                                           FontSize="15"
                                           Foreground="{StaticResource MutedTextBrush}" />

                                <TextBlock Grid.Row="2"
                                           Margin="0,24,0,0"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Text="Quick login preset" />

                                <ComboBox x:Name="QuickLoginCombo"
                                          Grid.Row="3"
                                          Style="{StaticResource FieldComboStyle}"
                                          ItemsSource="{Binding QuickLoginOptions}"
                                          SelectedItem="{Binding SelectedQuickLogin}"
                                          SelectionChanged="QuickLoginCombo_SelectionChanged" />

                                <Grid Grid.Row="4"
                                      Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Style="{StaticResource SectionLabelStyle}"
                                               Text="Database connection" />

                                    <Button Grid.Column="1"
                                            Padding="12,7"
                                            Content="Refresh"
                                            Style="{StaticResource NeutralButtonStyle}"
                                            Command="{Binding RefreshConnectionCommand}" />
                                </Grid>

                                <ComboBox Grid.Row="5"
                                          Style="{StaticResource FieldComboStyle}"
                                          ItemsSource="{Binding ConnectionProfiles}"
                                          SelectedItem="{Binding SelectedConnectionProfile}" />

                                <Border Grid.Row="6"
                                        Margin="0,8,0,0"
                                        Padding="12"
                                        CornerRadius="14"
                                        Background="{StaticResource ConnectionInfoBrush}"
                                        BorderBrush="{StaticResource ConnectionInfoBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedConnectionCaption}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding SelectedConnectionDetails}"
                                                   Margin="0,4,0,0"
                                                   FontSize="12.5"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="7"
                                        Margin="0,14,0,0"
                                        Padding="14"
                                        CornerRadius="16"
                                        Visibility="{Binding HasConnectionFeedback, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource ErrorSurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource ErrorBorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnectionReady}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <TextBlock Text="{Binding ConnectionStatusTitle}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding ConnectionStatusMessage}"
                                                   Margin="0,5,0,0"
                                                   TextWrapping="Wrap"
                                                   FontSize="13.5"
                                                   LineHeight="21"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Row="8"
                                           Margin="0,20,0,0"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Text="Username" />

                                <TextBox Grid.Row="9"
                                         x:Name="UsernameInput"
                                         Style="{StaticResource FieldTextBoxStyle}"
                                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                                <Grid Grid.Row="10"
                                      Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Style="{StaticResource SectionLabelStyle}"
                                               Text="Password" />

                                    <CheckBox x:Name="ShowPasswordToggle"
                                              Grid.Column="1"
                                              Content="Show password"
                                              VerticalAlignment="Center"
                                              Foreground="{StaticResource MutedTextBrush}"
                                              Checked="ShowPasswordToggle_Changed"
                                              Unchecked="ShowPasswordToggle_Changed" />
                                </Grid>

                                <Grid Grid.Row="11"
                                      Margin="0,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <PasswordBox x:Name="PasswordInput"
                                                     Style="{StaticResource FieldPasswordStyle}"
                                                     PasswordChanged="PasswordInput_PasswordChanged"
                                                     KeyDown="PasswordInput_KeyDown" />

                                        <TextBox x:Name="VisiblePasswordInput"
                                                 Style="{StaticResource FieldTextBoxStyle}"
                                                 Visibility="Collapsed"
                                                 TextChanged="VisiblePasswordInput_TextChanged"
                                                 KeyDown="PasswordInput_KeyDown" />
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Margin="0,14,0,0"
                                            Padding="14"
                                            CornerRadius="16"
                                            Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource PanelSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource ErrorSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource ErrorBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsStatusSuccess}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding StatusMessage}"
                                                   TextWrapping="Wrap"
                                                   FontSize="13.5"
                                                   LineHeight="21"
                                                   Foreground="{StaticResource TextBrush}" />
                                    </Border>

                                    <Grid Grid.Row="2"
                                          Margin="0,18,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button Margin="0,0,10,0"
                                                Content="Sign in"
                                                Style="{StaticResource LoginPrimaryButtonStyle}"
                                                Click="LoginButton_Click" />

                                        <Button Grid.Column="1"
                                                Margin="10,0,0,0"
                                                Content="Cancel"
                                                Style="{StaticResource LoginSecondaryButtonStyle}"
                                                Command="{Binding CancelCommand}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
