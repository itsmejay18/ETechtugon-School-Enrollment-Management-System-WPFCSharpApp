<UserControl x:Class="School_Management_System.Wpf.Views.Shared.DataTableWorkspaceView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="FieldCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="#FFF8FBFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="520" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding Description}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>

                    <Grid Grid.Column="1"
                          HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Margin="0,0,10,0"
                                 MinWidth="180"
                                 Style="{StaticResource ToolbarTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column="1"
                                Margin="0,0,10,0"
                                Style="{StaticResource NeutralButtonStyle}"
                                Command="{Binding SearchCommand}"
                                Content="Search" />

                        <Button Grid.Column="2"
                                Margin="0,0,10,0"
                                Style="{StaticResource NeutralButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                Content="Refresh" />

                        <Button Grid.Column="3"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding OpenDetailsCommand}"
                                Content="Open selected" />
                    </Grid>
                </Grid>

                <Border Grid.Row="1"
                        Style="{StaticResource SectionCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding RecordCountText}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Records}"
                                  SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                                  MouseDoubleClick="RecordsGrid_OnMouseDoubleClick" />

                        <Border Grid.Row="2"
                                Margin="0,16,0,0"
                                Padding="16"
                                CornerRadius="16"
                                Background="#FFF7FAFE"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Modal-first record review"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="Select a row and open it in the dark-overlay modal instead of using a permanent side information column."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding OpenDetailsCommand}"
                                        Content="View details" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Popup IsOpen="{Binding IsDetailsModalOpen, Mode=OneWay}"
               AllowsTransparency="True"
               Placement="Center"
               PlacementTarget="{Binding ElementName=Root}"
               PopupAnimation="Fade"
               StaysOpen="True">
            <Border Margin="44"
                    MaxWidth="1080"
                    MaxHeight="780"
                    Style="{StaticResource ModalCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="30,28,30,24"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{Binding DetailsModalTitle}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding DetailsModalSubtitle}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Margin="18,0,0,0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource ModalCloseButtonStyle}"
                                    Command="{Binding CloseDetailsCommand}" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  Padding="30,24,30,30"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding DetailFields}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{Binding Value}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource TextBrush}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
