<UserControl x:Class="School_Management_System.Wpf.Views.Settings.CatalogCrudWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>

        <Style x:Key="FieldValueTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Padding="0,0,24,0"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,8,0,0"
                           Text="{Binding Description}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />

                <TextBlock Margin="0,28,0,8"
                           Text="Search"
                           Style="{StaticResource FieldLabelStyle}" />
                <TextBox Style="{StaticResource FieldTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding HasOption, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding OptionLabel}"
                               Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox Margin="0,6,0,0"
                              ItemsSource="{Binding Options}"
                              SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName" />
                </StackPanel>

                <Button Margin="0,12,0,0"
                        Content="Refresh list"
                        Style="{StaticResource NeutralButtonStyle}"
                        Command="{Binding RefreshCommand}" />
                <Button Margin="0,18,0,0"
                        Content="Add record"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddCommand}" />
                <Button Margin="0,10,0,0"
                        Content="Open selected"
                        Style="{StaticResource NeutralButtonStyle}"
                        Command="{Binding OpenDetailsCommand}" />
                <Button Margin="0,10,0,0"
                        Content="Edit selected"
                        Style="{StaticResource NeutralButtonStyle}"
                        Command="{Binding EditCommand}" />
                <Button Margin="0,10,0,0"
                        Content="Delete selected"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding DeleteCommand}" />

                <Border Margin="0,24,0,18"
                        Height="1"
                        Background="{StaticResource BorderBrushSoft}" />
                <TextBlock Text="Selected"
                           Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Margin="0,6,0,0"
                           Text="{Binding SelectedRecord.Code, TargetNullValue=No record selected}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,6,0,0"
                           Text="{Binding SelectedRecord.Name}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Margin="0,22,0,0"
                           Text="Status"
                           Style="{StaticResource FieldLabelStyle}" />
                <TextBlock Margin="0,6,0,0"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,18">
                <TextBlock Text="{Binding Title}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,8,0,0"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>

            <DataGrid Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      ItemsSource="{Binding Records}"
                      SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                      MouseDoubleClick="RecordsGrid_OnMouseDoubleClick"
                      BorderBrush="{StaticResource BorderBrushSoft}"
                      BorderThickness="1"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="150" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding DetailA}" Width="190" />
                    <DataGridTextColumn Header="Status" Binding="{Binding DetailB}" Width="190" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Popup IsOpen="{Binding IsEditorModalOpen, Mode=OneWay}"
               AllowsTransparency="True"
               Placement="Center"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               PopupAnimation="Fade"
               StaysOpen="True">
            <Border Margin="44"
                    MaxWidth="920"
                    MaxHeight="740"
                    Style="{StaticResource ModalCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="30,28,30,24"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding EditorModalTitle}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding EditorModalSubtitle}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Margin="18,0,0,0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource ModalCloseButtonStyle}"
                                    Command="{Binding CloseModalCommand}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1"
                          Margin="24,18,24,18">
                        <Border Style="{StaticResource ModalSectionBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,10,12">
                                    <TextBlock Text="{Binding CodeLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding Code}"
                                               Style="{StaticResource FieldValueTextStyle}"
                                               Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBox Margin="0,6,0,0"
                                             Style="{StaticResource FieldTextBoxStyle}"
                                             Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,12">
                                    <TextBlock Text="{Binding NameLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding Name}"
                                               Style="{StaticResource FieldValueTextStyle}"
                                               Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBox Margin="0,6,0,0"
                                             Style="{StaticResource FieldTextBoxStyle}"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Margin="0,0,0,12"
                                            Visibility="{Binding HasOption, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding OptionLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding SelectedOption.DisplayName}"
                                               Style="{StaticResource FieldValueTextStyle}"
                                               Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ComboBox Margin="0,6,0,0"
                                              ItemsSource="{Binding Options}"
                                              SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Margin="0,0,10,12"
                                            Visibility="{Binding HasExtra1, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Extra1Label}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding Extra1}"
                                               Style="{StaticResource FieldValueTextStyle}"
                                               Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBox Margin="0,6,0,0"
                                             Style="{StaticResource FieldTextBoxStyle}"
                                             Text="{Binding Extra1, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Grid.Column="1"
                                            Margin="10,0,0,12"
                                            Visibility="{Binding HasExtra2, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Extra2Label}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding Extra2}"
                                               Style="{StaticResource FieldValueTextStyle}"
                                               Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBox Margin="0,6,0,0"
                                             Style="{StaticResource FieldTextBoxStyle}"
                                             Text="{Binding Extra2, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <StackPanel Grid.Row="3"
                                            Grid.ColumnSpan="2"
                                            Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding DescriptionLabel}" Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Text="{Binding RecordDescription}"
                                               Style="{StaticResource FieldValueTextStyle}"
                                               Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBox Margin="0,6,0,0"
                                             Height="110"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Style="{StaticResource FieldTextBoxStyle}"
                                             Text="{Binding RecordDescription, UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="24"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}" />
                            <StackPanel Grid.Column="1"
                                        Margin="18,0,0,0"
                                        Orientation="Horizontal"
                                        Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Margin="0,0,10,0"
                                        Style="{StaticResource NeutralButtonStyle}"
                                        Command="{Binding CancelCommand}"
                                        Content="Cancel" />
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveCommand}"
                                        Content="Save" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
