<UserControl x:Class="School_Management_System.Wpf.Views.DashboardHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="BoardPatternBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#FF0E4E8C" />
            <GradientStop Offset="1" Color="#FF1D5FA8" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="BoardBaseBrush" Color="#FF0F3F73" />
        <SolidColorBrush x:Key="TileStudentBrush" Color="#FF185795" />
        <SolidColorBrush x:Key="TileFacultyBrush" Color="#FF2B78C6" />
        <SolidColorBrush x:Key="TileEnrollmentBrush" Color="#FF4093DD" />
        <SolidColorBrush x:Key="TileScheduleBrush" Color="#FF2D6DA8" />
        <SolidColorBrush x:Key="TileCalendarBrush" Color="#FF62ACE7" />
        <SolidColorBrush x:Key="TileSettingsBrush" Color="#FF226CB2" />
        <SolidColorBrush x:Key="TileDateBrush" Color="#FF123E6B" />
        <SolidColorBrush x:Key="BrandTileBrush" Color="#FF62ACE7" />
        <SolidColorBrush x:Key="TileStatusBrush" Color="#FFF1F8FF" />
        <SolidColorBrush x:Key="TileCountOneBrush" Color="#FFF7FBFF" />
        <SolidColorBrush x:Key="TileCountTwoBrush" Color="#FFE7F2FC" />
        <SolidColorBrush x:Key="TileCountThreeBrush" Color="#FFD8EAF9" />
        <SolidColorBrush x:Key="TileCountFourBrush" Color="#FFC9E0F6" />
        <SolidColorBrush x:Key="TileCountFiveBrush" Color="#FFB9D6F2" />
        <SolidColorBrush x:Key="TileLogoutBrush" Color="#FF2B78C6" />

        <Style x:Key="MetroTileButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF1D5FA8" />
            <Setter Property="BorderBrush" Value="#28FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#85FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LightTileButtonStyle" TargetType="Button" BasedOn="{StaticResource MetroTileButtonStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#FFF5FAFF" />
            <Setter Property="BorderBrush" Value="#FFBDD8F0" />
        </Style>

        <Style x:Key="InfoTileBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderBrush" Value="#28FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FF1D5FA8" />
        </Style>

        <Style x:Key="LightInfoTileBorderStyle" TargetType="Border" BasedOn="{StaticResource InfoTileBorderStyle}">
            <Setter Property="Background" Value="#FFF5FAFF" />
            <Setter Property="BorderBrush" Value="#FFBDD8F0" />
        </Style>

        <Style x:Key="TileGlyphStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="40" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="TileTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="TileBodyStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="FontSize" Value="10.8" />
            <Setter Property="LineHeight" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#EEF7FF" />
        </Style>

        <Style x:Key="TileMetricStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="TileMetricCaptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#EEF7FF" />
        </Style>

        <Style x:Key="LightTileMetricStyle" TargetType="TextBlock" BasedOn="{StaticResource TileMetricStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style x:Key="LightTileMetricCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource TileMetricCaptionStyle}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BoardBaseBrush}"
          ClipToBounds="True"
          TextOptions.TextFormattingMode="Display">
        <Grid.RowDefinitions>
            <RowDefinition Height="0" />
            <RowDefinition Height="0.52*" />
            <RowDefinition Height="2.62*" />
            <RowDefinition Height="1.82*" />
            <RowDefinition Height="2.04*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.02*" />
            <ColumnDefinition Width="1.02*" />
            <ColumnDefinition Width="1.02*" />
            <ColumnDefinition Width="1.02*" />
            <ColumnDefinition Width="1.16*" />
            <ColumnDefinition Width="1.16*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="1"
                Grid.ColumnSpan="6"
                Background="{StaticResource BoardPatternBrush}">
            <UniformGrid Rows="2" Columns="12">
                <Border Background="#10000000" />
                <Border Background="#10FFFFFF" />
                <Border Background="#08000000" />
                <Border Background="#16FFFFFF" />
                <Border Background="#0A000000" />
                <Border Background="#13FFFFFF" />
                <Border Background="#09000000" />
                <Border Background="#18FFFFFF" />
                <Border Background="#08000000" />
                <Border Background="#14FFFFFF" />
                <Border Background="#09000000" />
                <Border Background="#17FFFFFF" />
                <Border Background="#0A000000" />
                <Border Background="#17FFFFFF" />
                <Border Background="#09000000" />
                <Border Background="#12FFFFFF" />
                <Border Background="#0A000000" />
                <Border Background="#18FFFFFF" />
                <Border Background="#09000000" />
                <Border Background="#14FFFFFF" />
                <Border Background="#08000000" />
                <Border Background="#17FFFFFF" />
                <Border Background="#0A000000" />
                <Border Background="#11FFFFFF" />
            </UniformGrid>
        </Border>

        <Button Grid.Row="2"
                Grid.Column="0"
                Margin="1"
                Background="{StaticResource TileStudentBrush}"
                Style="{StaticResource MetroTileButtonStyle}"
                Command="{Binding DataContext.ShowStudentsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                Visibility="{Binding DataContext.CanAccessStudents, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Style="{StaticResource TileGlyphStyle}" Text="&#xE716;" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource TileTitleStyle}" Text="Students" />
                <TextBlock Style="{StaticResource TileBodyStyle}" Text="Student files and learner records." />
            </StackPanel>
        </Button>

        <Border Grid.Row="2"
                Grid.Column="0"
                Margin="1"
                Background="{StaticResource TileStudentBrush}"
                Style="{StaticResource InfoTileBorderStyle}"
                Visibility="{Binding DataContext.CanAccessStudents, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Style="{StaticResource TileGlyphStyle}" Text="&#xE716;" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource TileTitleStyle}" Text="Students" />
                <TextBlock Style="{StaticResource TileMetricStyle}" Text="{Binding StudentsCount, StringFormat={}{0:N0}}" />
                <TextBlock Style="{StaticResource TileMetricCaptionStyle}" Text="active learner records" />
            </StackPanel>
        </Border>

        <Button Grid.Row="2"
                Grid.Column="1"
                Margin="1"
                Background="{StaticResource TileFacultyBrush}"
                Style="{StaticResource MetroTileButtonStyle}"
                Command="{Binding DataContext.ShowFacultyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                Visibility="{Binding DataContext.CanAccessFaculty, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Style="{StaticResource TileGlyphStyle}" Text="&#xE77B;" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource TileTitleStyle}" Text="Faculty" />
                <TextBlock Style="{StaticResource TileBodyStyle}" Text="Profiles, assignments, and staff records." />
            </StackPanel>
        </Button>

        <Border Grid.Row="2"
                Grid.Column="1"
                Margin="1"
                Background="{StaticResource TileFacultyBrush}"
                Style="{StaticResource InfoTileBorderStyle}"
                Visibility="{Binding DataContext.CanAccessFaculty, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Style="{StaticResource TileGlyphStyle}" Text="&#xE77B;" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource TileTitleStyle}" Text="Faculty" />
                <TextBlock Style="{StaticResource TileMetricStyle}" Text="{Binding FacultyCount, StringFormat={}{0:N0}}" />
                <TextBlock Style="{StaticResource TileMetricCaptionStyle}" Text="active staff records" />
            </StackPanel>
        </Border>

        <Button Grid.Row="2"
                Grid.Column="2"
                Margin="1"
                Background="{StaticResource TileEnrollmentBrush}"
                Style="{StaticResource MetroTileButtonStyle}"
                Command="{Binding DataContext.ShowEnrollmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                Visibility="{Binding DataContext.CanAccessEnrollment, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Style="{StaticResource TileGlyphStyle}" Text="&#xE8C8;" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource TileTitleStyle}" Text="Enrollment" />
                <TextBlock Style="{StaticResource TileBodyStyle}" Text="Registration and intake review." />
            </StackPanel>
        </Button>

        <Border Grid.Row="2"
                Grid.Column="2"
                Margin="1"
                Background="{StaticResource TileEnrollmentBrush}"
                Style="{StaticResource InfoTileBorderStyle}"
                Visibility="{Binding DataContext.CanAccessEnrollment, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Style="{StaticResource TileGlyphStyle}" Text="&#xE8C8;" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource TileTitleStyle}" Text="Programs" />
                <TextBlock Style="{StaticResource TileMetricStyle}" Text="{Binding CoursesCount, StringFormat={}{0:N0}}" />
                <TextBlock Style="{StaticResource TileMetricCaptionStyle}" Text="courses available for enrollment" />
            </StackPanel>
        </Border>

        <Button Grid.Row="2"
                Grid.Column="3"
                Margin="1"
                Background="{StaticResource TileScheduleBrush}"
                Style="{StaticResource MetroTileButtonStyle}"
                Command="{Binding DataContext.ShowScheduleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                Visibility="{Binding DataContext.CanAccessSchedule, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Style="{StaticResource TileGlyphStyle}" Text="&#xE787;" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource TileTitleStyle}" Text="Schedule" />
                <TextBlock Style="{StaticResource TileBodyStyle}" Text="Timetable and section planning." />
            </StackPanel>
        </Button>

        <Border Grid.Row="2"
                Grid.Column="4"
                Grid.ColumnSpan="2"
                Margin="1"
                Background="{StaticResource BrandTileBrush}"
                BorderBrush="#28FFFFFF"
                BorderThickness="1"
                Padding="10"
                ClipToBounds="True">
            <Border Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    SnapsToDevicePixels="True">
                <Image x:Name="HeroBrandLogoImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </Border>

        <Border Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="1"
                Background="{StaticResource TileDateBrush}"
                Style="{StaticResource InfoTileBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding CurrentDateText}"
                           FontSize="30"
                           FontWeight="Light"
                           Foreground="White"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="1"
                           Text="{Binding CurrentTimeText}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#EAF6FF" />
            </Grid>
        </Border>

        <Button Grid.Row="3"
                Grid.Column="3"
                Margin="1"
                Background="{StaticResource TileCalendarBrush}"
                Style="{StaticResource MetroTileButtonStyle}"
                Command="{Binding DataContext.ShowCalendarCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                Visibility="{Binding DataContext.CanAccessCalendar, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Style="{StaticResource TileGlyphStyle}" Text="&#xE163;" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource TileTitleStyle}" Text="Calendar" />
                <TextBlock Style="{StaticResource TileBodyStyle}" Text="Academic dates and events." />
            </StackPanel>
        </Button>

        <Border Grid.Row="3"
                Grid.Column="4"
                Margin="1"
                Background="{StaticResource TileStatusBrush}"
                Style="{StaticResource LightInfoTileBorderStyle}">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Text="DATABASE CONNECTED"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock Margin="0,8,0,0"
                           Text="{Binding ConnectionModeDisplay}"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,10,0,0"
                           Text="{Binding DashboardConnectionSummary}"
                           FontSize="10.8"
                           LineHeight="15"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <Button Grid.Row="3"
                Grid.Column="5"
                Margin="1"
                Background="{StaticResource TileSettingsBrush}"
                Style="{StaticResource MetroTileButtonStyle}"
                Command="{Binding DataContext.ShowSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                Visibility="{Binding DataContext.CanAccessSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Style="{StaticResource TileGlyphStyle}" Text="&#xE713;" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource TileTitleStyle}" Text="Settings" />
                <TextBlock Style="{StaticResource TileBodyStyle}" Text="Branding, users, and system setup." />
            </StackPanel>
        </Button>

        <Button Grid.Row="3"
                Grid.Column="5"
                Margin="1"
                Background="{StaticResource TileSettingsBrush}"
                Style="{StaticResource MetroTileButtonStyle}"
                Command="{Binding DataContext.ShowProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                Visibility="{Binding DataContext.CanAccessSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Style="{StaticResource TileGlyphStyle}" Text="&#xE77B;" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource TileTitleStyle}" Text="{Binding CurrentUserName}" />
                <TextBlock Style="{StaticResource TileBodyStyle}" Text="{Binding WorkspaceLabel}" />
            </StackPanel>
        </Button>

        <Button Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="1"
                Background="{StaticResource TileCountThreeBrush}"
                Style="{StaticResource LightTileButtonStyle}"
                Command="{Binding DataContext.ShowCurriculumSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                Visibility="{Binding DataContext.CanAccessCurriculumSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Top">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="36"
                           Foreground="{StaticResource PrimaryBrush}"
                           Text="&#xE7BE;" />
                <TextBlock Margin="0,12,0,0"
                           Text="Curriculum Settings"
                           FontSize="17"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,10,0,0"
                           Text="Courses, subjects, sections, departments, and academic references."
                           FontSize="11"
                           LineHeight="15"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Button>

        <Border Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="1"
                Background="{StaticResource TileCountThreeBrush}"
                Style="{StaticResource LightInfoTileBorderStyle}"
                Visibility="{Binding DataContext.CanAccessCurriculumSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Top">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="34"
                               Foreground="{StaticResource PrimaryBrush}"
                               Text="&#xE7BE;" />
                    <TextBlock Margin="0,12,0,0"
                               Text="Subjects"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Style="{StaticResource LightTileMetricStyle}" Text="{Binding SubjectsCount, StringFormat={}{0:N0}}" />
                    <TextBlock Style="{StaticResource LightTileMetricCaptionStyle}" Text="active subject records" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,18,0" VerticalAlignment="Top">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="34"
                               Foreground="{StaticResource PrimaryBrush}"
                               Text="&#xE8F1;" />
                    <TextBlock Margin="0,12,0,0"
                               Text="Departments"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Style="{StaticResource LightTileMetricStyle}" Text="{Binding DepartmentsCount, StringFormat={}{0:N0}}" />
                    <TextBlock Style="{StaticResource LightTileMetricCaptionStyle}" Text="academic departments" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="34"
                               Foreground="{StaticResource PrimaryBrush}"
                               Text="&#xE8A5;" />
                    <TextBlock Margin="0,12,0,0"
                               Text="Workspace"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="0,12,0,0"
                               Text="{Binding TotalRecordsText}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Style="{StaticResource LightTileMetricCaptionStyle}" Text="{Binding OperatorLine}" />
                </StackPanel>
            </Grid>
        </Border>

        <Button Grid.Row="4"
                Grid.Column="3"
                Grid.ColumnSpan="2"
                Margin="1"
                Background="{StaticResource TileCountFiveBrush}"
                Style="{StaticResource LightTileButtonStyle}"
                Command="{Binding DataContext.ShowAnalyticsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                Visibility="{Binding DataContext.CanAccessAnalytics, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Top">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="36"
                           Foreground="{StaticResource PrimaryBrush}"
                           Text="&#xE9D2;" />
                <TextBlock Margin="0,12,0,0"
                           Text="Analytics"
                           FontSize="17"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,10,0,0"
                           Text="Open school counts and database overview."
                           FontSize="11"
                           LineHeight="15"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Button>

        <Border Grid.Row="4"
                Grid.Column="3"
                Grid.ColumnSpan="2"
                Margin="1"
                Background="{StaticResource TileCountFiveBrush}"
                Style="{StaticResource LightInfoTileBorderStyle}"
                Visibility="{Binding DataContext.CanAccessAnalytics, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Top">
                <TextBlock FontFamily="Segoe MDL2 Assets"
                           FontSize="36"
                           Foreground="{StaticResource PrimaryBrush}"
                           Text="&#xE9D2;" />
                <TextBlock Margin="0,12,0,0"
                           Text="School Overview"
                           FontSize="17"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,12,0,0"
                           Text="{Binding TotalRecordsText}"
                           FontSize="22"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,10,0,0"
                           Text="{Binding DatabaseStatusDetail}"
                           FontSize="11"
                           LineHeight="15"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <Button Grid.Row="4"
                Grid.Column="5"
                Margin="1"
                Background="{StaticResource TileLogoutBrush}"
                Style="{StaticResource MetroTileButtonStyle}"
                Command="{Binding DataContext.LogoutCommand, RelativeSource={RelativeSource AncestorType=Window}}">
            <StackPanel VerticalAlignment="Top">
                <TextBlock Style="{StaticResource TileGlyphStyle}" Text="&#xE8AC;" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource TileTitleStyle}" Text="Log out" />
                <TextBlock Style="{StaticResource TileBodyStyle}" Text="Return to sign-in." />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
