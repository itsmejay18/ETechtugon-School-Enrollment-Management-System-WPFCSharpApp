<UserControl x:Class="School_Management_System.Wpf.Views.Students.StudentDirectoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="DetailCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF8FBFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Student directory"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="Live student records, selected profile details, and current-term enrolled subjects."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Margin="0,0,10,0"
                             Padding="12,8"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1"
                            Margin="0,0,10,0"
                            Padding="18,10"
                            Style="{StaticResource NeutralButtonStyle}"
                            Command="{Binding SearchCommand}"
                            Content="Search" />
                    <Button Grid.Column="2"
                            Padding="18,10"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            Content="Refresh" />
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="0.95*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardBorderStyle}"
                        Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="{Binding RecordCountText}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  AutoGenerateColumns="True"
                                  ItemsSource="{Binding Records}"
                                  SelectedItem="{Binding SelectedRecord, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Grid Grid.Column="1"
                      Margin="18,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.02*" />
                        <RowDefinition Height="0.98*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="84"
                                        Height="84"
                                        CornerRadius="18"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        Background="#FFF4F9FF">
                                    <Grid>
                                        <Image Source="{Binding StudentPhoto}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding HasPhoto, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="34"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   Text="&#xE77B;"
                                                   Visibility="{Binding HasPhoto, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="14,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Selected student"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Margin="0,6,0,0"
                                               Text="{Binding ProfileSummary}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="1"
                                       Margin="0,18,0,10"
                                       Text="Profile fields"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}" />

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding DetailFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource DetailCardStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="12.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource PrimaryBrush}" />
                                                    <TextBlock Margin="0,6,0,0"
                                                               Text="{Binding Value}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource TextBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Margin="0,18,0,0"
                            Style="{StaticResource CardBorderStyle}"
                            Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Current term enrolled subjects"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="This table is loaded from the same active academic term settings used by the school system."
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      AutoGenerateColumns="True"
                                      ItemsSource="{Binding EnrolledSubjects}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
