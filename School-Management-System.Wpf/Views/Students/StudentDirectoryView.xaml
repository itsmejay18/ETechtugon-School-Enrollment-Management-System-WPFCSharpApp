<UserControl x:Class="School_Management_System.Wpf.Views.Students.StudentDirectoryView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:School_Management_System.Wpf.Services">
    <UserControl.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="services:DataGridColumnDisplay.UseCompactColumns" Value="True" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>

        <Style x:Key="FieldCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF8FBFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Margin" Value="0,0,10,10" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Style>

        <Style x:Key="FieldValueTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style x:Key="FieldDatePickerStyle" TargetType="DatePicker">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <Style x:Key="ModalActionButtonStyle" TargetType="Button" BasedOn="{StaticResource NeutralButtonStyle}">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="ModalPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="ModalDangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DangerButtonStyle}">
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Padding="0,0,24,0"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Student Profile"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="Search student profiles and filter records by Regular, Irregular, or Summer status."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />

                        <TextBlock Margin="0,28,0,8"
                                   Text="Find students"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" />
                        <TextBox Style="{StaticResource ToolbarTextBoxStyle}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,14,0,8"
                                   Text="Student type"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" />
                        <ComboBox ItemsSource="{Binding StudentTypeFilterOptions}"
                                  SelectedItem="{Binding SelectedStudentTypeFilter, Mode=TwoWay}" />

                        <Button Margin="0,12,0,0"
                                Style="{StaticResource NeutralButtonStyle}"
                                Command="{Binding SearchCommand}"
                                Content="Search records" />
                        <Button Margin="0,10,0,0"
                                Style="{StaticResource NeutralButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                Content="Refresh list" />
                        <Button Margin="0,18,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding AddCommand}"
                                Content="Add student" />
                        <Button Margin="0,10,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding OpenDetailsCommand}"
                                Content="Open profile" />

                        <Border Margin="0,24,0,18"
                                Height="1"
                                Background="{StaticResource BorderBrushSoft}" />

                        <TextBlock Text="Loaded records"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding RecordCountText}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextBrush}" />

                        <TextBlock Margin="0,22,0,0"
                                   Text="Selected student"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding ProfileSummary}"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />

                        <TextBlock Margin="0,22,0,0"
                                   Text="Workflow"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="Add starts here, then the profile modal handles save, edit, and delete for the selected student."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Student profiles"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Top"
                                       Text="{Binding RecordCountText}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" />
                    </Grid>

                    <DataGrid Grid.Row="1"
                              AutoGenerateColumns="True"
                              ItemsSource="{Binding Records}"
                              SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                              MouseLeftButtonUp="RecordsGrid_OnMouseLeftButtonUp" />
                </Grid>
            </Grid>
        </Border>

        <Popup IsOpen="{Binding IsDetailsModalOpen, Mode=OneWay}"
               AllowsTransparency="True"
               Placement="Center"
               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
               PopupAnimation="Fade"
               StaysOpen="True">
            <Border Margin="40"
                    MaxWidth="1240"
                    MaxHeight="860"
                    Style="{StaticResource ModalCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="30,28,30,24"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="84"
                                    Height="84"
                                    CornerRadius="24"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    Background="#FFF4F9FF">
                                <Grid>
                                    <Image Source="{Binding StudentPhoto}"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding HasPhoto, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="34"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Text="&#xE77B;"
                                               Visibility="{Binding HasPhoto, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DetailsModalTitle}"
                                               FontSize="30"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <Border Margin="14,5,0,0"
                                            Padding="10,4"
                                            VerticalAlignment="Top"
                                            Background="#FFEAF4FF"
                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <TextBlock Text="{Binding StudentTypeBadgeText}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0"
                                           Text="{Binding DetailsModalSubtitle}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="18,0,0,0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Top"
                                        Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Style="{StaticResource ModalActionButtonStyle}"
                                        Command="{Binding EditCommand}"
                                        Content="Edit" />
                                <Button Style="{StaticResource ModalDangerActionButtonStyle}"
                                        Command="{Binding DeleteCommand}"
                                        Content="Delete" />
                            </StackPanel>

                            <Button Grid.Column="3"
                                    Margin="18,0,0,0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource ModalCloseButtonStyle}"
                                    Command="{Binding CloseModalCommand}" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1"
                          Margin="24,18,24,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.55*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource ModalSectionBorderStyle}"
                                Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Student information"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Text="{Binding ModalStatusMessage}"
                                                   TextWrapping="Wrap"
                                                   FontSize="12.5"
                                                   Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Margin="12,0,0,0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top"
                                                Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Style="{StaticResource ModalActionButtonStyle}"
                                                Command="{Binding UploadPhotoCommand}"
                                                Content="Upload photo" />
                                        <Button Style="{StaticResource ModalDangerActionButtonStyle}"
                                                Command="{Binding RemovePhotoCommand}"
                                                Content="Remove photo" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="2"
                                      Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Student Number"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding StudentNumber}"
                                                       Style="{StaticResource FieldValueTextStyle}"
                                                       Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBox Margin="0,6,0,0"
                                                     Style="{StaticResource FieldTextBoxStyle}"
                                                     IsReadOnly="True"
                                                     Text="{Binding StudentNumber}"
                                                     Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Margin="0,12,0,0"
                                                       Text="Student Type"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding SelectedStudentType}"
                                                       Style="{StaticResource FieldValueTextStyle}"
                                                       Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ComboBox Margin="0,6,0,0"
                                                      Style="{StaticResource FieldComboBoxStyle}"
                                                      ItemsSource="{Binding StudentTypeOptions}"
                                                      SelectedItem="{Binding SelectedStudentType, UpdateSourceTrigger=PropertyChanged}"
                                                      Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Margin="0,12,0,0"
                                                       Text="Academic Status"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding AcademicStatus}"
                                                       Style="{StaticResource FieldValueTextStyle}"
                                                       Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBox Margin="0,6,0,0"
                                                     Style="{StaticResource FieldTextBoxStyle}"
                                                     Text="{Binding AcademicStatus, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1"
                                            Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="First Name"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding FirstName}"
                                                       Style="{StaticResource FieldValueTextStyle}"
                                                       Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBox Margin="0,6,0,0"
                                                     Style="{StaticResource FieldTextBoxStyle}"
                                                     Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1"
                                            Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Last Name"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding LastName}"
                                                       Style="{StaticResource FieldValueTextStyle}"
                                                       Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBox Margin="0,6,0,0"
                                                     Style="{StaticResource FieldTextBoxStyle}"
                                                     Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1"
                                            Grid.Column="1"
                                            Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Middle Name"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding MiddleName}"
                                                       Style="{StaticResource FieldValueTextStyle}"
                                                       Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBox Margin="0,6,0,0"
                                                     Style="{StaticResource FieldTextBoxStyle}"
                                                     Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2"
                                            Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Gender"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding SelectedGender}"
                                                       Style="{StaticResource FieldValueTextStyle}"
                                                       Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ComboBox Margin="0,6,0,0"
                                                      Style="{StaticResource FieldComboBoxStyle}"
                                                      ItemsSource="{Binding GenderOptions}"
                                                      SelectedItem="{Binding SelectedGender, UpdateSourceTrigger=PropertyChanged}"
                                                      Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2"
                                            Grid.Column="1"
                                            Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Birth Date"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding BirthDate, StringFormat={}{0:M/d/yyyy}}"
                                                       Style="{StaticResource FieldValueTextStyle}"
                                                       Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <DatePicker Margin="0,6,0,0"
                                                        Style="{StaticResource FieldDatePickerStyle}"
                                                        SelectedDate="{Binding BirthDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="3"
                                            Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Email"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding Email}"
                                                       Style="{StaticResource FieldValueTextStyle}"
                                                       Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBox Margin="0,6,0,0"
                                                     Style="{StaticResource FieldTextBoxStyle}"
                                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="3"
                                            Grid.Column="1"
                                            Style="{StaticResource FieldCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Phone"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding Phone}"
                                                       Style="{StaticResource FieldValueTextStyle}"
                                                       Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBox Margin="0,6,0,0"
                                                     Style="{StaticResource FieldTextBoxStyle}"
                                                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="4"
                                            Grid.ColumnSpan="2"
                                            Style="{StaticResource FieldCardStyle}"
                                            Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="Address"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding Address}"
                                                       MaxHeight="42"
                                                       Style="{StaticResource FieldValueTextStyle}"
                                                       Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBox Margin="0,6,0,0"
                                                     Height="70"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Style="{StaticResource FieldTextBoxStyle}"
                                                     Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Margin="0,12,0,0"
                                                       Text="Curriculum"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="{Binding SelectedCurriculum.DisplayName}"
                                                       Style="{StaticResource FieldValueTextStyle}"
                                                       Visibility="{Binding IsPreviewMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ComboBox Margin="0,6,0,0"
                                                      Style="{StaticResource FieldComboBoxStyle}"
                                                      ItemsSource="{Binding CurriculumOptions}"
                                                      SelectedItem="{Binding SelectedCurriculum, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName"
                                                      Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource ModalSectionBorderStyle}"
                                Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Academic records"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Margin="0,4,0,0"
                                               Text="Current, completed, failed, remaining, and semester records for the selected student."
                                               TextWrapping="Wrap"
                                               FontSize="12.5"
                                               Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>

                                <TabControl Grid.Row="1"
                                            MinHeight="240">
                                    <TabItem Header="Current">
                                        <DataGrid AutoGenerateColumns="True"
                                                  ItemsSource="{Binding EnrolledSubjects}" />
                                    </TabItem>
                                    <TabItem Header="History">
                                        <DataGrid AutoGenerateColumns="True"
                                                  ItemsSource="{Binding EnrollmentHistory}" />
                                    </TabItem>
                                    <TabItem Header="Completed">
                                        <DataGrid AutoGenerateColumns="True"
                                                  ItemsSource="{Binding CompletedSubjects}" />
                                    </TabItem>
                                    <TabItem Header="Failed">
                                        <DataGrid AutoGenerateColumns="True"
                                                  ItemsSource="{Binding FailedSubjects}" />
                                    </TabItem>
                                    <TabItem Header="Remaining">
                                        <DataGrid AutoGenerateColumns="True"
                                                  ItemsSource="{Binding RemainingSubjects}" />
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="24"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding ModalStatusMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedTextBrush}" />

                            <StackPanel Grid.Column="1"
                                        Margin="18,0,0,0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Visibility="{Binding IsEditorActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Style="{StaticResource ModalActionButtonStyle}"
                                        Command="{Binding CancelCommand}"
                                        Content="Cancel" />
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding SaveCommand}"
                                        Content="Save" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
