<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\School-Management-System\assets\app-logo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
    <RootNamespace>School_Management_System.Wpf</RootNamespace>
    <AssemblyName>School-Management-System.Wpf</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\School-Management-System\School-Management-System.csproj">
      <Private>true</Private>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <!--
    Declare the runtime-only dependencies the legacy WinForms project pulls
    in. Listing them here lets MSBuild's AutoGenerateBindingRedirects emit
    correct redirects in the produced .exe.config so the deployed app does
    not hit FileLoadException on the client PC.
  -->
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <None Include="App.config" />
    <Content Include="..\School-Management-System\assets\app-logo.ico">
      <Link>assets\app-logo.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\School-Management-System\assets\brand-logo.png">
      <Link>assets\brand-logo.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\newbranding.png">
      <Link>assets\newbranding.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\companylogo.png">
      <Link>assets\companylogo.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\clientlogo.png">
      <Link>assets\clientlogo.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The referenced WinForms project uses packages.config and references
    several assemblies (BouncyCastle, K4os, Google.Protobuf, ZstdSharp, etc.)
    that the SDK-style WPF project does not flow transitively. Copy every DLL
    produced in the WinForms output folder into this project's output so the
    deployed app has all runtime dependencies for MySqlConnector + backups.
  -->
  <Target Name="CopyWinFormsTransitiveDependencies"
          AfterTargets="AfterBuild"
          Condition="Exists('..\School-Management-System\bin\$(Configuration)')">
    <ItemGroup>
      <_WinFormsTransitiveDeps Include="..\School-Management-System\bin\$(Configuration)\*.dll" />
      <_WinFormsTransitiveDeps Remove="..\School-Management-System\bin\$(Configuration)\School-Management-System.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinFormsTransitiveDeps)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true"
          Retries="3"
          RetryDelayMilliseconds="200" />
  </Target>
</Project>
